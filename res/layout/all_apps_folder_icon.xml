<!-- Folder shown in the app drawer. The label uses the exact app drawer icon style (and display),
     so its size, font, color and the "Icon labels in drawer" setting match the app labels. -->
<com.android.launcher3.folder.FolderIcon
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:defaultFocusHighlightEnabled="false">
    <com.android.launcher3.BubbleTextView
        style="@style/BaseIcon.AllApps"
        android:id="@+id/folder_icon_name"
        android:focusable="false"
        android:stateListAnimator="@null"
        android:layout_gravity="top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        launcher:iconDisplay="all_apps"
        launcher:centerVertically="false" />
</com.android.launcher3.folder.FolderIcon>
